{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=finai;Username=finai;Password=finai"
  },
  "Jwt": {
    "Issuer": "FinAI",
    "Audience": "FinAI.Clients",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30
  },
  "Ai": {
    "Provider": "Ollama",
    "BaseUrl": "http://ollama:11434",
    "ChatModel": "llama3.2",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 60,
    "Enabled": true
  },
  "Documents": {
    "StoragePath": "/app/data/documents"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
