{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=finai;Username=finai;Password=finai"
  },
  "Jwt": {
    "Issuer": "FinAI",
    "Audience": "FinAI.Clients",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30
  },
  "Analytics": {
    "MinSamplesForZScore": 8,
    "AnomalyZScoreThreshold": 3.0
  },
  "Ai": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "llama3.2",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 60,
    "ClassificationCacheEnabled": true
  },
  "RateLimiting": {
    "GeneralPerMinute": 120,
    "AiPerMinute": 30,
    "AuthPerMinute": 5
  },
  "Pluggy": {
    "BaseUrl": "https://api.pluggy.ai",
    "ClientId": "${PLUGGY_CLIENT_ID}",
    "ClientSecret": "${PLUGGY_CLIENT_SECRET}",
    "ItemId": "${PLUGGY_ITEM_ID}",
    "ImportSinceDays": 90,
    "PageSize": 100,
    "AutoClassify": true,
    "ScheduleEnabled": false,
    "ScheduleIntervalHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
